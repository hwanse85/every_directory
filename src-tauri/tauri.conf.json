{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Every Directory",
  "version": "0.7.9",
  "identifier": "com.everydirectory.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Every Directory",
        "width": 1440,
        "height": 960,
        "minWidth": 900,
        "minHeight": 640,
        "backgroundColor": "#edf1f5",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: edfile: http://edfile.localhost; media-src 'self' blob: edfile: http://edfile.localhost; connect-src 'self' ipc: http://ipc.localhost edfile: http://edfile.localhost; worker-src 'self' blob:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean",
          "English"
        ],
        "displayLanguageSelector": true,
        "startMenuFolder": "Every Directory",
        "installerHooks": "windows/lite-hooks.nsh"
      }
    }
  }
}
