{
  "name": "every-directory",
  "version": "0.7.8",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run desktop:dev",
    "build": "tsc -b && vite build",
    "preview": "tsx server/main.ts --production",
    "test": "tsx --test tests/*.test.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "start": "tsx server/main.ts --production",
    "dev:web": "tsx server/main.ts",
    "dev:ui": "vite --host 127.0.0.1",
    "desktop:dev": "node scripts/desktop.mjs dev",
    "desktop:build": "node scripts/desktop.mjs build",
    "test:rust": "node scripts/desktop.mjs test",
    "test:windows-ui": "node scripts/test-windows-ui.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "licenses:check": "node scripts/check-licenses.mjs",
    "privacy:check": "node scripts/check-privacy.mjs",
    "desktop:package:mac": "node scripts/package-macos.mjs",
    "desktop:build:windows": "node scripts/package-windows.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
